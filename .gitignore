.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/
.DS_Store

# Raw/processed data is large and re-fetchable — never commit it
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# pybaseball's own on-disk cache
.pybaseball_cache/

# local secrets
.env
*.token
